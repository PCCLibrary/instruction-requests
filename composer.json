{
    "name": "laravel/laravel",
    "type": "project",
    "require": {
        "php": "^8.1",
        "blade-ui-kit/blade-heroicons": "^2.5",
        "blade-ui-kit/blade-icons": "^1.7",
        "blade-ui-kit/blade-ui-kit": "^0.6.4",
        "joshhanley/livewire-autocomplete": "^2.1",
        "lakm/laravel-comments": "^2.2",
        "laravel/framework": "^11.0",
        "laravel/socialite": "^5.18",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "livewire/livewire": "^3.0",
        "lowerrocklabs/laravel-lockable": "^1.4",
        "masmerise/livewire-toaster": "^2.6",
        "power-components/livewire-powergrid": "^6.1.11",
        "socialiteproviders/saml2": "^4.7",
        "spatie/laravel-google-calendar": "^3.8",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^2.3",
        "mockery/mockery": "^1.4.4",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.0",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
